# Models are several GB and should not be included in the repository
# Users should obtain them via hf download
models/
*.safetensors
*.bin
*.gguf
*.ggml

# ===== Whisper Model =====
# GGML models automatically downloaded by pywhispercpp
*.ggml
ggml-*.bin

